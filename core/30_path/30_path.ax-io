# AX-ZSH: Alex' Modular ZSH Configuration
# 30_path.ax-io: Setup PATH environment

# Set default PATH
if [[ -x /usr/libexec/path_helper ]]; then
	eval "$(/usr/libexec/path_helper)"
else
	path=()
	# Prefer /usr/[s]bin over /[s]bin: The /usr hierarchy is assumed to
	# contain the "more advanced" tools than the / hierarchy.
	[[ $UID -eq 0 && -e /usr/sbin ]] && path+=(/usr/sbin)
	[[ -e /usr/bin ]] && path+=(/usr/bin)
	# Add the toplevel /[s]bin directories, but only if they are not
	# symlinks: The latter most probably indicates a unified /usr & /
	# hierarchy and we do not want to have directory content twice.
	[[ $UID -eq 0 && ! -h /sbin && -e /sbin ]] && path+=(/sbin)
	[[ ! -h /bin && -e /bin ]] && path+=(/bin)
fi
typeset -Ux PATH

_axzsh_setup_path() {
	# Prepend additional search paths
	for d (
		/Developer/usr/{,s}bin
		/system/{,s}bin
		/system/non-packaged/{,s}bin
		/usr/ucb
		/usr/pkg/{,s}bin
		/usr/local/{,s}bin
		/opt/*/bin(NOn)
		/opt/*/sbin(NOn)
		/home/linuxbrew/.linuxbrew/{,s}bin
		~/.gem/ruby/*/bin(NOn)
		~/.go/bin
		~/.cargo/bin
		~/.local/{,s}bin
		~/{,s}bin
		~/Applications
	); do
		[[ "$d" = */sbin && $UID -ne 0 ]] && continue
		[[ -d "$d" ]] && path=("$d" $path)
	done

	# Append additional search paths
	for d (
		/usr/X11/bin
		/usr/local/games
		/usr/games
	); do
		[[ -d "$d" ]] && path=($path "$d")
	done
}

# Prepend and append search paths (in a special order!)
_axzsh_setup_path
